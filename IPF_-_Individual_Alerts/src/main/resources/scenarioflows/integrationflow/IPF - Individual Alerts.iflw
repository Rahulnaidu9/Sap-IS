    table {
        border-collapse: collapse;
        border: 1px solid #000000;

    }
    th, td {
        border: 1px solid #000000;
        padding: 2px 10px;
    }

    .header {
        background-color: #4267B2;
        text-align: left;
        font-weight: bold;
        white-space: nowrap;
    }
&lt;/style&gt;
&lt;/head&gt;
    &lt;body&gt;
        &lt;p&gt;The following standard error alert has been raised. Use this link to &lt;a href="https://${property.tenantName}.integrationsuite.${property.tenantDomain}:443/shell/monitoring/MessageDetails/%7B%22messageGuid%22%3A%22${header.EH_alert_MplId}%22%7D"&gt;jump to the monitor&lt;/a&gt;:&lt;/p&gt;
        &lt;table&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;SAP Integration Suite (IS) Environment&lt;/td&gt;
                &lt;td&gt;${property.EP_notfns_environment}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Integration Flow Name&lt;/td&gt;
                &lt;td&gt;${header.EH_alert_iflowName}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Source System&lt;/td&gt;
                &lt;td&gt;${header.SAP_Sender}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Target System&lt;/td&gt;
                &lt;td&gt;${header.SAP_Receiver}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;TECK_Entity&lt;/td&gt;
                &lt;td&gt;${header.TECK_Entity}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Date and Time&lt;/td&gt;
                &lt;td&gt;${header.EH_alert_dateTime}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Message ID&lt;/td&gt;
                &lt;td&gt;${header.EH_alert_MplId}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Correlation ID&lt;/td&gt;
                &lt;td&gt;${header.SAP_MplCorrelationId}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Exception Message&lt;/td&gt;
                &lt;td&gt;${header.EH_alert_Message}&lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td class="header"&gt;Exception Stacktrace&lt;/td&gt;
                &lt;td&gt;${header.EH_alert_StackTrace}&lt;/td&gt;
            &lt;/tr&gt;
        &lt;/table&gt;
    &lt;/body&gt;
&lt;/html&gt;</value>
                </ifl:property>
